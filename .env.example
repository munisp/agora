# OpenDesk .env.example — copy to .env and adjust. Every value below is a
# DEV-ONLY default that matches docker-compose.yml's ${VAR:-default}
# fallbacks, so the stack boots without a .env at all. In production these
# come from SOPS/Vault instead — see docs/runbooks/secrets.md.

# ---------------------------------------------------------------------------
# Postgres (superuser — infra only, apps should use per-service roles below)
# ---------------------------------------------------------------------------
POSTGRES_USER=opendesk
POSTGRES_PASSWORD=opendesk

# Per-service DB roles (SPEC-W3 §2 / SPEC-W43 G-01,
# infra/postgres/init-scripts/05-app-roles.sql). Each service has a NOLOGIN
# group role holding the grants; services connect with the LOGIN variants
# below. As of SPEC-W43 these roles are the DEFAULTS in docker-compose.yml —
# the opendesk superuser (POSTGRES_USER/POSTGRES_PASSWORD above) is for
# migration/bootstrap jobs ONLY (schema DDL, pg_restore, billing migrations
# 0001-0004, first-boot DDL not yet moved into infra init scripts). The
# superuser bypasses FORCE ROW LEVEL SECURITY, so tenant isolation only
# holds end-to-end when runtime traffic uses these app roles.
BOOKING_PG_USER=app_booking_login
BOOKING_PG_PASS=app_booking_dev_password
#CONVERSATION_PG_USER=app_conversation_login
#CONVERSATION_PG_PASS=app_conversation_dev_password
#KNOWLEDGE_PG_USER=app_knowledge_login
#KNOWLEDGE_PG_PASS=app_knowledge_dev_password
#IDENTITY_PG_USER=app_identity_login
#IDENTITY_PG_PASS=app_identity_dev_password
#NOTIFICATIONS_PG_USER=app_notifications_login
#NOTIFICATIONS_PG_PASS=app_notifications_dev_password
#CRM_SYNC_PG_USER=app_crm_sync_login
#CRM_SYNC_PG_PASS=app_crm_sync_dev_password
#BILLING_PG_USER=app_billing_login
#BILLING_PG_PASS=app_billing_dev_password
#KYC_PG_USER=app_kyc_login
#KYC_PG_PASS=app_kyc_dev_password

# ---------------------------------------------------------------------------
# Keycloak (identity)
# ---------------------------------------------------------------------------
# Client secret of the `service-accounts` client (realm opendesk).
# SPEC-W34 GF5: the shipped realm no longer carries a real secret — the
# placeholder below MUST be replaced for any non-local deployment and the
# matching secret set in infra/keycloak/realm-opendesk.json before import.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_DEV_ONLY
# REQUIRED (SPEC-W34 GF5): infra/docker-compose.core.yml fails fast without
# it (${KC_BOOTSTRAP_ADMIN_PASSWORD:?...}). Dev-only bootstrap admin for the
# Keycloak master realm; rotate immediately after first login.
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-dev-only
# App platform lifecycle CloudEvents topic (SPEC-W18; identity-service
# internal/apps — AppProvisioned/AppStatusChanged via pubsub-kafka).
APPS_LIFECYCLE_TOPIC=opendesk.apps.lifecycle.v1

# ---------------------------------------------------------------------------
# LiveKit (voice)
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---------------------------------------------------------------------------
# LLM (voice runtime + any LLM-judge/NER features; Ollama works out of box)
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:8b
# Only needed for hosted providers (e.g. MiniMax): LLM_BASE_URL=https://api.minimax.io/v1
#LLM_API_KEY=

# ---------------------------------------------------------------------------
# Admin web (NextAuth)
# ---------------------------------------------------------------------------
AUTH_SECRET=dev-secret-change-me

# ---------------------------------------------------------------------------
# Twenty CRM (crm-sync)
# ---------------------------------------------------------------------------
TWENTY_API_KEY=opendesk-dev-twenty-api-key
TWENTY_WEBHOOK_SECRET=opendesk-dev-twenty-webhook-secret
TWENTY_ACCESS_TOKEN_SECRET=opendesk-twenty-access-token-dev
TWENTY_LOGIN_TOKEN_SECRET=opendesk-twenty-login-token-dev
TWENTY_REFRESH_TOKEN_SECRET=opendesk-twenty-refresh-token-dev
TWENTY_FILE_TOKEN_SECRET=opendesk-twenty-file-token-dev
TWENTY_APP_SECRET=opendesk-twenty-app-secret-dev

# ---------------------------------------------------------------------------
# MinIO (lakehouse + GDPR export bundles)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------------------------------------------------------------------------
# Dapr component secrets (dev env-var secret store)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=
SMTP_PASSWORD=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Nigeria messaging channel (messaging-gateway; see
# docs/integrations/messaging-channels.md). Empty = provider disabled (503).
# ---------------------------------------------------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=OpenDesk
AT_API_KEY=
AT_USERNAME=
AT_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Per-tenant provider routing for notification-worker (optional JSON):
#MESSAGING_CHANNELS=email:smtp,sms:twilio
#TENANT_CHANNEL_MAP={"acme-ng": {"sms": "termii"}, "default": {"sms": "twilio"}}

# ---------------------------------------------------------------------------
# Gateway static secrets (NOT env-driven in dev — edit infra/apisix/apisix.yaml):
#   - jwt-auth HS256 consumer secret (opendesk-dev-jwt-hs256-secret-change-in-prod)
#   - openid-connect session secret (opendesk-dev-session-secret-0123456789abcdef)
# Both must be rotated for any non-local deployment (docs/runbooks/secrets.md).
# ---------------------------------------------------------------------------

# Misc non-secret toggles with compose fallbacks:
#AGENT_BACKEND=livekit
# LEDGER_IMPL moved to the W44 F16-7 boot-blocking block below (payments
# refuses to boot without it).

# Model registry internal writer DSN (SPEC-W34 GF1): used by the batch
# training snapshot sync (--registry-sync) and other internal writers that
# must bypass tenant RLS via the app_model_registry_batch LOGIN role.
# infra/docker-compose.core.yml wires this for model-registry already.
#MODEL_REGISTRY_INTERNAL_DSN=postgresql://app_model_registry_batch:app_model_registry_batch_dev_password@postgres:5432/platform

# ---------------------------------------------------------------------------
# NDPA 2023 compliance profile (Nigeria) — docs/compliance/ndpa.md.
# These are the profile values; copy the whole block from
# infra/privacy/ndpa-profile.env when deploying for Nigerian tenants.
#   RETENTION_DAYS=180        turn hard-delete window (platform default 365)
#   VOICEPRINTS=off           biometric speaker ID off (sensitive data, NDPA)
#   INTEL_LLM=off             no transcript text leaves for LLM NER
# Data residency is NOT env-driven: self-host in-country (compose or the
# deploy/k3s appliance) — see the "Storage / residency" notes in
# infra/privacy/ndpa-profile.env.
# ---------------------------------------------------------------------------
#RETENTION_ENABLED=true
#RETENTION_DAYS=180
#VOICEPRINTS=off
#INTEL_LLM=off

# ---------------------------------------------------------------------------
# Referrals + commissions (Wave 14, CAC app) — booking-service, contract §7.
#   COMMISSIONS_ENABLED=true   referral/commission endpoints (503 when off)
#   PAYOUT_PROVIDER=paystack   payout provider (paystack|flutterwave; mock via PAYOUT_MOCK)
#   PAYOUT_MIN_NGN=100         minimum payout amount (naira)
#   RECON_CRON=30 2 * * *      commission-recon-nightly schedule (Africa/Lagos 02:30)
# ---------------------------------------------------------------------------
#COMMISSIONS_ENABLED=true
#PAYOUT_PROVIDER=paystack
#PAYOUT_MIN_NGN=100
#RECON_CRON=30 2 * * *

# ---------------------------------------------------------------------------
# Lending disbursement rail (SPEC-W24 WS-B2) — booking-service consumer of
# com.opendesk.lending.DisbursementIntent on LENDING_EVENTS_TOPIC, creating
# the TigerBeetle transfer via the payments bridge (account codes 500/501,
# idempotency key from the intent ref_id; exactly-once under redelivery).
#   LENDING_TB_BRIDGE_URL=          empty = mock rail (TB unconfigured, no
#                                   money moved — the payments LEDGER_IMPL=sim
#                                   posture); set to the payments-service
#                                   Dapr invoke gateway for live transfers,
#                                   e.g. http://daprd-booking:3500/v1.0/invoke/payments/method
#   LENDING_DISBURSEMENTS_GROUP=    consumer group (default booking-lending-disbursements)
# ---------------------------------------------------------------------------
#LENDING_TB_BRIDGE_URL=
#LENDING_DISBURSEMENTS_GROUP=

# Platform data seeding (SPEC-W17; scripts/seeds/*)
SEED_SALT=opendesk-dev-seed-salt-change-in-prod
SEED_SCALE=1.0
SEED_KAFKA=off
SEED_REPORT_PATH=/var/tmp/seed_reports.jsonl
SEED_MANIFEST_DIR=/var/tmp/seed_manifests

# ---------------------------------------------------------------------------
# SPEC-W21 (additive, ONE block): election-channel readiness.
#
# Social Publisher (booking-service /v1/social, app "social-publisher";
# docs/apps/social-publisher.md). W39 contract: SOCIAL_MOCK code default is
# OFF (fail-closed); the dev docker-compose.yml opts in explicitly (DEV ONLY
# — mock rail). Keep 0 here unless running booking-service OUTSIDE the dev
# compose. A provider leaves mock mode only when BOTH SOCIAL_MOCK=0 AND its
# own *_MOCK=0 — today that selects the honest "not configured" stub (real
# API credential wiring is a follow-up).
# Metering (social_ad_launched) rides the existing USAGE_EVENTS_TOPIC.
# ---------------------------------------------------------------------------
SOCIAL_EVENTS_TOPIC=opendesk.social.events.v1
SOCIAL_MOCK=0
META_MOCK=1
TIKTOK_MOCK=1
X_MOCK=1

# ---------------------------------------------------------------------------
# WhatsApp campaign channel (SPEC-W21 Agent A — notification-worker
# whatsapp_campaign paced kind + messaging-gateway Cloud API transport;
# docs/apps/campaign-studio.md). W39 contract: WHATSAPP_MOCK code default is
# OFF (fail-closed) in BOTH notification-worker and messaging-gateway; the
# dev docker-compose.yml opts in explicitly (DEV ONLY — mock rail: mock logs
# the send + returns a fake wamid; messaging-gateway additionally accepts
# UNSIGNED inbound posts and logs CRITICAL). Keep 0 here; set 1 only for
# flows outside the dev compose. NOTE: WHATSAPP_PHONE_NUMBER_ID intentionally
# duplicates the messaging-gateway entry above (same Meta phone number id;
# last value wins in env_file parsers).
# ---------------------------------------------------------------------------
WHATSAPP_MOCK=0
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_API_BASE_URL=

# ---------------------------------------------------------------------------
# SPEC-W38 (additive, ONE block): agent-as-product registry + capture
# primitive.
#
# Agents registry (voice + voice-worker): dialed E.164 number ->
# conversation-service /v1/agents/resolve (internal, not gateway-exposed).
#   AGENTS_REGISTRY_URL=   conversation-service base URL (no APISIX)
#   AGENTS_CACHE_TTL_S=    resolve-response cache TTL in the voice runtime
# NOTE: TENANT_PHONE_MAP remains the FALLBACK — when the registry lookup
# misses or is unreachable, the static env map keeps dev mode working.
# Capture primitive: conversation-service extracts structured fields
# post-call (LLM, INTEL_LLM_* config) into capture_records and publishes
# com.opendesk.conversation.CaptureExtracted to CAPTURE_TOPIC; crm-sync
# consumes CAPTURES_TOPIC (group crm-sync-capture) and writes a Twenty
# note. CAPTURE_ENABLED defaults to the INTEL_LLM value (no LLM, no
# capture).
# ---------------------------------------------------------------------------
#AGENTS_REGISTRY_URL=http://conversation:7007
#AGENTS_CACHE_TTL_S=30
#CAPTURE_TOPIC=opendesk.conversation.captures
#CAPTURES_TOPIC=opendesk.conversation.captures
#CAPTURE_ENABLED=off

# ---------------------------------------------------------------------------
# W39 mock-rail contract (ALL code defaults OFF / fail-closed). The dev
# docker-compose.yml opts into the mocks the dev stack actually needs with
# loud "DEV ONLY — mock rail" comments, so you normally do NOT set these in
# .env at all. Set one to 1 only when running a service OUTSIDE the dev
# compose (sidecar-less flows). NEVER set any of these in production.
# ---------------------------------------------------------------------------
#ALLOW_MOCK_RAILS=0        # booking lending: simulated disbursement rail
#PAYOUT_MOCK=0             # booking referrals: simulated payout provider
#SOCIAL_MOCK=0             # booking socialpub: see the SPEC-W21 block above
#FCM_MOCK=0                # notification-worker: simulated FCM push sends
#WHATSAPP_MOCK=0           # messaging-gateway + notification-worker: see above
#MOJALOOP_ALLOW_SIM=0      # payments: allow the mojaloop-simulator endpoint
#GATEWAY_EDGE_ALLOW_SIM=0  # gateway-edge: allow the Fluvio stub consumer
#KYC_MOCK=0                # kyc-service: deterministic mock resolver (GF8)
#MMS_MOCK=0                # mms-tts sidecar (infra/compose/voices.compose.yml)
#XTTS_MOCK=0               # xtts-tts sidecar (infra/compose/voices.compose.yml)

# ---------------------------------------------------------------------------
# W39 billing internal-auth + ledger contract (SPEC-W7, billing-engine).
#   BILLING_LEDGER_IMPL   real impl is the default (postgres — DATABASE_URL +
#                         self-applying migrations); "sim" is an explicit
#                         dev/test opt-in only — never silent. billing-engine
#                         accepts ONLY postgres|sim (any other value aborts
#                         boot).
#   BILLING_INTERNAL_TOKEN in-cluster SERVICE callers of billing must carry
#                         an x-internal-token header matching this value.
#                         APISIX STRIPS any client-supplied x-internal-token;
#                         W44 F1 removed the former injection on /api/billing/*
#                         — human calls use K1 header binding + roles.
# ---------------------------------------------------------------------------
#BILLING_LEDGER_IMPL=postgres
BILLING_INTERNAL_TOKEN=opendesk-dev-billing-internal-token-change-in-prod

# ---------------------------------------------------------------------------
# SPEC-W44 K2 internal-token contract (boot-blocking / gate-on vars).
# Every /internal/*, /activities/* and dev/* surface requires an
# X-Internal-Token header matching the service's *_INTERNAL_TOKEN env
# (constant-time compare; 503 fail-closed when unset, 401 on mismatch).
# Values below are DEV ONLY (*-dev-token-change-in-prod) and match the
# docker-compose.yml ${VAR:-default} fallbacks; production MUST set them via
# the secrets store (docs/runbooks/secrets.md). In-cluster callers
# (notification-worker activities, service-to-service calls, k3s deployments)
# must use the SAME value as the target service. W44 F1: APISIX does NOT
# inject internal tokens on any route — human calls use K1 binding + roles.
# ---------------------------------------------------------------------------
PAYMENTS_INTERNAL_TOKEN=opendesk-dev-payments-internal-token-change-in-prod
IDENTITY_INTERNAL_TOKEN=opendesk-dev-identity-internal-token-change-in-prod
NOTIFICATION_INTERNAL_TOKEN=opendesk-dev-notification-internal-token-change-in-prod
BOOKING_INTERNAL_TOKEN=opendesk-dev-booking-internal-token-change-in-prod

# ---------------------------------------------------------------------------
# SPEC-W44 F16-7 (partial): boot-blocking vars for running services OUTSIDE
# the dev compose (compose itself carries ${VAR:-default} fallbacks for all
# of these — cp .env.example .env is only needed for bare/e2e runs).
# ---------------------------------------------------------------------------
# payments-service: REFUSES to boot without an explicit ledger selection
# (src/config.rs). sim = in-memory dev ledger (moves no real money);
# tigerbeetle = live ledger (needs TB_ADDRESSES).
LEDGER_IMPL=sim
# payments-service: Mojaloop FSPIOP endpoint. Compose points at the bundled
# simulator (http://mojaloop:8444); a bare run needs a reachable endpoint AND
# MOJALOOP_ALLOW_SIM=1, or boot aborts (fail-closed).
#MOJALOOP_ENDPOINT=http://localhost:8444
#MOJALOOP_ALLOW_SIM=1
# booking-service: HMAC secret for 15-min customer-portal JWTs. W44 B-side:
# boot fails when this still equals the dev default unless
# OPENDESK_DEV_INSECURE=1 — set a real value for any non-local deployment.
PORTAL_SECRET=opendesk-dev-portal-secret-change-in-prod
# DEV ONLY: required for local boot while PORTAL_SECRET above is the dev
# default. Delete this line for any non-local deployment.
OPENDESK_DEV_INSECURE=1
# gateway-edge: opt-in Fluvio stub consumer when running without a Fluvio
# broker. The default compose build now compiles the fluvio-live feature
# (CARGO_FEATURES=fluvio-live build arg, W44 F15-01), so this stays 0/unset.
#GATEWAY_EDGE_ALLOW_SIM=0
# graph-service (infra/docker-compose.graph.yml): REQUIRED since W44
# S1-F6-01 — no compose default anymore (${INTERNAL_TOKEN:?...}). Guards the
# /v1/graph/internal/* write-back routes; graph-ml/graph-ml-gpu read the
# same variable. The graph overlay also sets REQUIRE_JWT=1 (startup raises
# when JWT_PUBLIC_KEY is empty); set JWT_PUBLIC_KEY or REQUIRE_JWT=0
# explicitly for header-seam e2e.
INTERNAL_TOKEN=opendesk-dev-internal-token
#JWT_PUBLIC_KEY=
#REQUIRE_JWT=1
# voice-worker: /metrics (prometheus_client) port, scraped by the Prometheus
# voice-worker job (infra/observability/prometheus/prometheus.yml).
VOICE_WORKER_METRICS_PORT=9464

# ---------------------------------------------------------------------------
# W39 graph dev/e2e seams (infra/docker-compose.graph.yml) — SAFE DEFAULTS
# OFF since W39 SIM-028. e2e suites that rely on header-based tenant auth or
# the fixture seeder must opt in EXPLICITLY in the e2e runner environment:
#AUTHZ_DISABLED=true       # graph-service: X-Tenant-Slug header auth seam
#E2E_FIXTURES=1            # graph-service: POST /v1/graph/internal/fixtures/seed
# ---------------------------------------------------------------------------
