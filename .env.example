# OpenDesk .env.example — copy to .env and adjust. Every value below is a
# DEV-ONLY default that matches docker-compose.yml's ${VAR:-default}
# fallbacks, so the stack boots without a .env at all. In production these
# come from SOPS/Vault instead — see docs/runbooks/secrets.md.

# ---------------------------------------------------------------------------
# Postgres (superuser — infra only, apps should use per-service roles below)
# ---------------------------------------------------------------------------
POSTGRES_USER=opendesk
POSTGRES_PASSWORD=opendesk

# Per-service DB roles (SPEC-W3 §2, infra/postgres/init-scripts/05-app-roles.sql).
# The NOLOGIN group roles are app_booking / app_conversation / app_knowledge;
# services connect with the LOGIN variants below. Defaults keep the shared
# opendesk superuser for dev parity — set these to enforce RLS end-to-end.
BOOKING_PG_USER=app_booking_login
BOOKING_PG_PASS=app_booking_dev_password
#CONVERSATION_PG_USER=app_conversation_login
#CONVERSATION_PG_PASS=app_conversation_dev_password
#KNOWLEDGE_PG_USER=app_knowledge_login
#KNOWLEDGE_PG_PASS=app_knowledge_dev_password

# ---------------------------------------------------------------------------
# Keycloak (identity)
# ---------------------------------------------------------------------------
# Client secret of the `service-accounts` client (realm opendesk).
KEYCLOAK_ADMIN_CLIENT_SECRET=opendesk-service-secret
# App platform lifecycle CloudEvents topic (SPEC-W18; identity-service
# internal/apps — AppProvisioned/AppStatusChanged via pubsub-kafka).
APPS_LIFECYCLE_TOPIC=opendesk.apps.lifecycle.v1

# ---------------------------------------------------------------------------
# LiveKit (voice)
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---------------------------------------------------------------------------
# LLM (voice runtime + any LLM-judge/NER features; Ollama works out of box)
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:8b
# Only needed for hosted providers (e.g. MiniMax): LLM_BASE_URL=https://api.minimax.io/v1
#LLM_API_KEY=

# ---------------------------------------------------------------------------
# Admin web (NextAuth)
# ---------------------------------------------------------------------------
AUTH_SECRET=dev-secret-change-me

# ---------------------------------------------------------------------------
# Twenty CRM (crm-sync)
# ---------------------------------------------------------------------------
TWENTY_API_KEY=opendesk-dev-twenty-api-key
TWENTY_WEBHOOK_SECRET=opendesk-dev-twenty-webhook-secret
TWENTY_ACCESS_TOKEN_SECRET=opendesk-twenty-access-token-dev
TWENTY_LOGIN_TOKEN_SECRET=opendesk-twenty-login-token-dev
TWENTY_REFRESH_TOKEN_SECRET=opendesk-twenty-refresh-token-dev
TWENTY_FILE_TOKEN_SECRET=opendesk-twenty-file-token-dev
TWENTY_APP_SECRET=opendesk-twenty-app-secret-dev

# ---------------------------------------------------------------------------
# MinIO (lakehouse + GDPR export bundles)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------------------------------------------------------------------------
# Dapr component secrets (dev env-var secret store)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=
SMTP_PASSWORD=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Nigeria messaging channel (messaging-gateway; see
# docs/integrations/messaging-channels.md). Empty = provider disabled (503).
# ---------------------------------------------------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=OpenDesk
AT_API_KEY=
AT_USERNAME=
AT_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Per-tenant provider routing for notification-worker (optional JSON):
#MESSAGING_CHANNELS=email:smtp,sms:twilio
#TENANT_CHANNEL_MAP={"acme-ng": {"sms": "termii"}, "default": {"sms": "twilio"}}

# ---------------------------------------------------------------------------
# Gateway static secrets (NOT env-driven in dev — edit infra/apisix/apisix.yaml):
#   - jwt-auth HS256 consumer secret (opendesk-dev-jwt-hs256-secret-change-in-prod)
#   - openid-connect session secret (opendesk-dev-session-secret-0123456789abcdef)
# Both must be rotated for any non-local deployment (docs/runbooks/secrets.md).
# ---------------------------------------------------------------------------

# Misc non-secret toggles with compose fallbacks:
#AGENT_BACKEND=livekit
#LEDGER_IMPL=sim

# ---------------------------------------------------------------------------
# NDPA 2023 compliance profile (Nigeria) — docs/compliance/ndpa.md.
# These are the profile values; copy the whole block from
# infra/privacy/ndpa-profile.env when deploying for Nigerian tenants.
#   RETENTION_DAYS=180        turn hard-delete window (platform default 365)
#   VOICEPRINTS=off           biometric speaker ID off (sensitive data, NDPA)
#   INTEL_LLM=off             no transcript text leaves for LLM NER
# Data residency is NOT env-driven: self-host in-country (compose or the
# deploy/k3s appliance) — see the "Storage / residency" notes in
# infra/privacy/ndpa-profile.env.
# ---------------------------------------------------------------------------
#RETENTION_ENABLED=true
#RETENTION_DAYS=180
#VOICEPRINTS=off
#INTEL_LLM=off

# ---------------------------------------------------------------------------
# Referrals + commissions (Wave 14, CAC app) — booking-service, contract §7.
#   COMMISSIONS_ENABLED=true   referral/commission endpoints (503 when off)
#   PAYOUT_PROVIDER=paystack   payout provider (paystack|flutterwave; mock via PAYOUT_MOCK)
#   PAYOUT_MIN_NGN=100         minimum payout amount (naira)
#   RECON_CRON=30 2 * * *      commission-recon-nightly schedule (Africa/Lagos 02:30)
# ---------------------------------------------------------------------------
#COMMISSIONS_ENABLED=true
#PAYOUT_PROVIDER=paystack
#PAYOUT_MIN_NGN=100
#RECON_CRON=30 2 * * *

# Platform data seeding (SPEC-W17; scripts/seeds/*)
SEED_SALT=opendesk-dev-seed-salt-change-in-prod
SEED_SCALE=1.0
SEED_KAFKA=off
SEED_REPORT_PATH=/var/tmp/seed_reports.jsonl
SEED_MANIFEST_DIR=/var/tmp/seed_manifests

# ---------------------------------------------------------------------------
# SPEC-W21 (additive, ONE block): election-channel readiness.
#
# Social Publisher (booking-service /v1/social, app "social-publisher";
# docs/apps/social-publisher.md). All providers default to the
# DETERMINISTIC MOCK (no network): a provider leaves mock mode only when
# BOTH SOCIAL_MOCK=0 AND its own *_MOCK=0 — today that selects the honest
# "not configured" stub (real API credential wiring is a follow-up).
# Metering (social_ad_launched) rides the existing USAGE_EVENTS_TOPIC.
# ---------------------------------------------------------------------------
SOCIAL_EVENTS_TOPIC=opendesk.social.events.v1
SOCIAL_MOCK=1
META_MOCK=1
TIKTOK_MOCK=1
X_MOCK=1

# ---------------------------------------------------------------------------
# WhatsApp campaign channel (SPEC-W21 Agent A — notification-worker
# whatsapp_campaign paced kind + messaging-gateway Cloud API transport;
# docs/apps/campaign-studio.md). WHATSAPP_MOCK=1 is the zero-config
# default (mock logs the send + returns a fake wamid — the FCM_MOCK
# posture). NOTE: WHATSAPP_PHONE_NUMBER_ID intentionally duplicates the
# messaging-gateway entry above (same Meta phone number id; last value
# wins in env_file parsers).
# ---------------------------------------------------------------------------
WHATSAPP_MOCK=1
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_API_BASE_URL=
