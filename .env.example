# OpenDesk .env.example — copy to .env and adjust. Every value below is a
# DEV-ONLY default that matches docker-compose.yml's ${VAR:-default}
# fallbacks, so the stack boots without a .env at all. In production these
# come from SOPS/Vault instead — see docs/runbooks/secrets.md.

# ---------------------------------------------------------------------------
# Postgres (superuser — infra only, apps should use per-service roles below)
# ---------------------------------------------------------------------------
POSTGRES_USER=opendesk
POSTGRES_PASSWORD=opendesk

# Per-service DB roles (SPEC-W3 §2 / SPEC-W43 G-01,
# infra/postgres/init-scripts/05-app-roles.sql). Each service has a NOLOGIN
# group role holding the grants; services connect with the LOGIN variants
# below. As of SPEC-W43 these roles are the DEFAULTS in docker-compose.yml —
# the opendesk superuser (POSTGRES_USER/POSTGRES_PASSWORD above) is for
# migration/bootstrap jobs ONLY (schema DDL, pg_restore, billing migrations
# 0001-0004, first-boot DDL not yet moved into infra init scripts). The
# superuser bypasses FORCE ROW LEVEL SECURITY, so tenant isolation only
# holds end-to-end when runtime traffic uses these app roles.
BOOKING_PG_USER=app_booking_login
BOOKING_PG_PASS=app_booking_dev_password
#CONVERSATION_PG_USER=app_conversation_login
#CONVERSATION_PG_PASS=app_conversation_dev_password
#KNOWLEDGE_PG_USER=app_knowledge_login
#KNOWLEDGE_PG_PASS=app_knowledge_dev_password
#IDENTITY_PG_USER=app_identity_login
#IDENTITY_PG_PASS=app_identity_dev_password
#NOTIFICATIONS_PG_USER=app_notifications_login
#NOTIFICATIONS_PG_PASS=app_notifications_dev_password
#CRM_SYNC_PG_USER=app_crm_sync_login
#CRM_SYNC_PG_PASS=app_crm_sync_dev_password
#BILLING_PG_USER=app_billing_login
#BILLING_PG_PASS=app_billing_dev_password
#KYC_PG_USER=app_kyc_login
#KYC_PG_PASS=app_kyc_dev_password
# W48-D (recon F6): PgBouncer pooler endpoint — only meaningful when the
# opt-in override `-f infra/compose/pgbouncer.compose.yml` is active
# (that override switches the Go/Rust service DSN hosts postgres:5432 ->
# pgbouncer:6432 itself). Leave empty otherwise; not read by service code.
#PGBOUNCER_URL=postgres://app_booking_login:app_booking_dev_password@pgbouncer:6432/booking

# ---------------------------------------------------------------------------
# Keycloak (identity)
# ---------------------------------------------------------------------------
# Client secret of the `service-accounts` client (realm opendesk).
# SPEC-W34 GF5: the shipped realm no longer carries a real secret — the
# placeholder below MUST be replaced for any non-local deployment and the
# matching secret set in infra/keycloak/realm-opendesk.json before import.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_DEV_ONLY
# REQUIRED (SPEC-W34 GF5): infra/docker-compose.core.yml fails fast without
# it (${KC_BOOTSTRAP_ADMIN_PASSWORD:?...}). Dev-only bootstrap admin for the
# Keycloak master realm; rotate immediately after first login.
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-dev-only
# App platform lifecycle CloudEvents topic (SPEC-W18; identity-service
# internal/apps — AppProvisioned/AppStatusChanged via pubsub-kafka).
APPS_LIFECYCLE_TOPIC=opendesk.apps.lifecycle.v1

# ---------------------------------------------------------------------------
# LiveKit (voice)
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---------------------------------------------------------------------------
# LLM (voice runtime + any LLM-judge/NER features; Ollama works out of box)
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:8b
# Only needed for hosted providers (e.g. MiniMax): LLM_BASE_URL=https://api.minimax.io/v1
#LLM_API_KEY=

# ---------------------------------------------------------------------------
# Admin web (NextAuth)
# ---------------------------------------------------------------------------
AUTH_SECRET=dev-secret-change-me

# ---------------------------------------------------------------------------
# Twenty CRM (crm-sync)
# ---------------------------------------------------------------------------
TWENTY_API_KEY=opendesk-dev-twenty-api-key
TWENTY_WEBHOOK_SECRET=opendesk-dev-twenty-webhook-secret
TWENTY_ACCESS_TOKEN_SECRET=opendesk-twenty-access-token-dev
TWENTY_LOGIN_TOKEN_SECRET=opendesk-twenty-login-token-dev
TWENTY_REFRESH_TOKEN_SECRET=opendesk-twenty-refresh-token-dev
TWENTY_FILE_TOKEN_SECRET=opendesk-twenty-file-token-dev
TWENTY_APP_SECRET=opendesk-twenty-app-secret-dev

# ---------------------------------------------------------------------------
# MinIO (lakehouse + GDPR export bundles)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# In-cluster MinIO endpoint (host:port on the opendesk docker network)
# consumed by services that store object bytes — e.g. ocr-service document
# uploads (SPEC-W53; compose default minio:9000).
MINIO_ENDPOINT=minio:9000

# ---------------------------------------------------------------------------
# Dapr component secrets (dev env-var secret store)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=
SMTP_PASSWORD=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Nigeria messaging channel (messaging-gateway; see
# docs/integrations/messaging-channels.md). Empty = provider disabled (503).
# ---------------------------------------------------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=OpenDesk
AT_API_KEY=
AT_USERNAME=
AT_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Per-tenant provider routing for notification-worker (optional JSON):
#MESSAGING_CHANNELS=email:smtp,sms:twilio
#TENANT_CHANNEL_MAP={"acme-ng": {"sms": "termii"}, "default": {"sms": "twilio"}}

# ---------------------------------------------------------------------------
# Gateway static secrets (NOT env-driven in dev — edit infra/apisix/apisix.yaml):
#   - jwt-auth HS256 consumer secret (opendesk-dev-jwt-hs256-secret-change-in-prod)
#   - openid-connect session secret (opendesk-dev-session-secret-0123456789abcdef)
# Both must be rotated for any non-local deployment (docs/runbooks/secrets.md).
# ---------------------------------------------------------------------------

# Misc non-secret toggles with compose fallbacks:
#AGENT_BACKEND=livekit
# LEDGER_IMPL moved to the W44 F16-7 boot-blocking block below (payments
# refuses to boot without it).

# Model registry internal writer DSN (SPEC-W34 GF1): used by the batch
# training snapshot sync (--registry-sync) and other internal writers that
# must bypass tenant RLS via the app_model_registry_batch LOGIN role.
# infra/docker-compose.core.yml wires this for model-registry already.
#MODEL_REGISTRY_INTERNAL_DSN=postgresql://app_model_registry_batch:app_model_registry_batch_dev_password@postgres:5432/platform

# ---------------------------------------------------------------------------
# NDPA 2023 compliance profile (Nigeria) — docs/compliance/ndpa.md.
# These are the profile values; copy the whole block from
# infra/privacy/ndpa-profile.env when deploying for Nigerian tenants.
#   RETENTION_DAYS=180        turn hard-delete window (platform default 365)
#   VOICEPRINTS=off           biometric speaker ID off (sensitive data, NDPA)
#   INTEL_LLM=off             no transcript text leaves for LLM NER
# Data residency is NOT env-driven: self-host in-country (compose or the
# deploy/k3s appliance) — see the "Storage / residency" notes in
# infra/privacy/ndpa-profile.env.
# ---------------------------------------------------------------------------
#RETENTION_ENABLED=true
#RETENTION_DAYS=180
#VOICEPRINTS=off
#INTEL_LLM=off

# ---------------------------------------------------------------------------
# Referrals + commissions (Wave 14, CAC app) — booking-service, contract §7.
#   COMMISSIONS_ENABLED=true   referral/commission endpoints (503 when off)
#   PAYOUT_PROVIDER=paystack   payout provider (paystack|flutterwave; mock via PAYOUT_MOCK)
#   PAYOUT_MIN_NGN=100         minimum payout amount (naira)
#   RECON_CRON=30 2 * * *      commission-recon-nightly schedule (Africa/Lagos 02:30)
# ---------------------------------------------------------------------------
#COMMISSIONS_ENABLED=true
#PAYOUT_PROVIDER=paystack
#PAYOUT_MIN_NGN=100
#RECON_CRON=30 2 * * *

# ---------------------------------------------------------------------------
# Lending disbursement rail (SPEC-W24 WS-B2) — booking-service consumer of
# com.opendesk.lending.DisbursementIntent on LENDING_EVENTS_TOPIC, creating
# the TigerBeetle transfer via the payments bridge (account codes 500/501,
# idempotency key from the intent ref_id; exactly-once under redelivery).
#   LENDING_TB_BRIDGE_URL=          empty = mock rail (TB unconfigured, no
#                                   money moved — the payments LEDGER_IMPL=sim
#                                   posture); set to the payments-service
#                                   Dapr invoke gateway for live transfers,
#                                   e.g. http://daprd-booking:3500/v1.0/invoke/payments/method
#   LENDING_DISBURSEMENTS_GROUP=    consumer group (default booking-lending-disbursements)
# ---------------------------------------------------------------------------
#LENDING_TB_BRIDGE_URL=
#LENDING_DISBURSEMENTS_GROUP=

# Platform data seeding (SPEC-W17; scripts/seeds/*)
SEED_SALT=opendesk-dev-seed-salt-change-in-prod
SEED_SCALE=1.0
SEED_KAFKA=off
SEED_REPORT_PATH=/var/tmp/seed_reports.jsonl
SEED_MANIFEST_DIR=/var/tmp/seed_manifests

# ---------------------------------------------------------------------------
# SPEC-W21 (additive, ONE block): election-channel readiness.
#
# Social Publisher (booking-service /v1/social, app "social-publisher";
# docs/apps/social-publisher.md). W39 contract: SOCIAL_MOCK code default is
# OFF (fail-closed); the dev docker-compose.yml opts in explicitly (DEV ONLY
# — mock rail). Keep 0 here unless running booking-service OUTSIDE the dev
# compose. A provider leaves mock mode only when BOTH SOCIAL_MOCK=0 AND its
# own *_MOCK=0 — today that selects the honest "not configured" stub (real
# API credential wiring is a follow-up).
# Metering (social_ad_launched) rides the existing USAGE_EVENTS_TOPIC.
# ---------------------------------------------------------------------------
SOCIAL_EVENTS_TOPIC=opendesk.social.events.v1
SOCIAL_MOCK=0
META_MOCK=1
TIKTOK_MOCK=1
X_MOCK=1

# ---------------------------------------------------------------------------
# WhatsApp campaign channel (SPEC-W21 Agent A — notification-worker
# whatsapp_campaign paced kind + messaging-gateway Cloud API transport;
# docs/apps/campaign-studio.md). W39 contract: WHATSAPP_MOCK code default is
# OFF (fail-closed) in BOTH notification-worker and messaging-gateway; the
# dev docker-compose.yml opts in explicitly (DEV ONLY — mock rail: mock logs
# the send + returns a fake wamid; messaging-gateway additionally accepts
# UNSIGNED inbound posts and logs CRITICAL). Keep 0 here; set 1 only for
# flows outside the dev compose. NOTE: WHATSAPP_PHONE_NUMBER_ID intentionally
# duplicates the messaging-gateway entry above (same Meta phone number id;
# last value wins in env_file parsers).
# ---------------------------------------------------------------------------
WHATSAPP_MOCK=0
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_API_BASE_URL=

# ---------------------------------------------------------------------------
# SPEC-W38 (additive, ONE block): agent-as-product registry + capture
# primitive.
#
# Agents registry (voice + voice-worker): dialed E.164 number ->
# conversation-service /v1/agents/resolve (internal, not gateway-exposed).
#   AGENTS_REGISTRY_URL=   conversation-service base URL (no APISIX)
#   AGENTS_CACHE_TTL_S=    resolve-response cache TTL in the voice runtime
# NOTE: TENANT_PHONE_MAP remains the FALLBACK — when the registry lookup
# misses or is unreachable, the static env map keeps dev mode working.
# Capture primitive: conversation-service extracts structured fields
# post-call (LLM, INTEL_LLM_* config) into capture_records and publishes
# com.opendesk.conversation.CaptureExtracted to CAPTURE_TOPIC; crm-sync
# consumes CAPTURES_TOPIC (group crm-sync-capture) and writes a Twenty
# note. CAPTURE_ENABLED defaults to the INTEL_LLM value (no LLM, no
# capture).
# ---------------------------------------------------------------------------
#AGENTS_REGISTRY_URL=http://conversation:7007
#AGENTS_CACHE_TTL_S=30
#CAPTURE_TOPIC=opendesk.conversation.captures
#CAPTURES_TOPIC=opendesk.conversation.captures
#CAPTURE_ENABLED=off

# ---------------------------------------------------------------------------
# W39 mock-rail contract (ALL code defaults OFF / fail-closed). The dev
# docker-compose.yml opts into the mocks the dev stack actually needs with
# loud "DEV ONLY — mock rail" comments, so you normally do NOT set these in
# .env at all. Set one to 1 only when running a service OUTSIDE the dev
# compose (sidecar-less flows). NEVER set any of these in production.
# ---------------------------------------------------------------------------
#ALLOW_MOCK_RAILS=0        # booking lending: simulated disbursement rail
#PAYOUT_MOCK=0             # booking referrals: simulated payout provider
#SOCIAL_MOCK=0             # booking socialpub: see the SPEC-W21 block above
#FCM_MOCK=0                # notification-worker: simulated FCM push sends
#WHATSAPP_MOCK=0           # messaging-gateway + notification-worker: see above
#MOJALOOP_ALLOW_SIM=0      # payments: allow the mojaloop-simulator endpoint
#GATEWAY_EDGE_ALLOW_SIM=0  # gateway-edge: allow the Fluvio stub consumer
#KYC_MOCK=0                # kyc-service: deterministic mock resolver (GF8)
#MMS_MOCK=0                # mms-tts sidecar (infra/compose/voices.compose.yml)
#XTTS_MOCK=0               # xtts-tts sidecar (infra/compose/voices.compose.yml)
#OCR_MOCK=false            # ocr-service: deterministic fixture extraction (SPEC-W53;
                          # XTTS_MOCK precedent — DEV/E2E ONLY, CRITICAL startup log,
                          # NEVER default/prod)

# ---------------------------------------------------------------------------
# W39 billing internal-auth + ledger contract (SPEC-W7, billing-engine).
#   BILLING_LEDGER_IMPL   real impl is the default (postgres — DATABASE_URL +
#                         self-applying migrations); "sim" is an explicit
#                         dev/test opt-in only — never silent. billing-engine
#                         accepts ONLY postgres|sim (any other value aborts
#                         boot).
#   BILLING_INTERNAL_TOKEN in-cluster SERVICE callers of billing must carry
#                         an x-internal-token header matching this value.
#                         APISIX STRIPS any client-supplied x-internal-token;
#                         W44 F1 removed the former injection on /api/billing/*
#                         — human calls use K1 header binding + roles.
# ---------------------------------------------------------------------------
#BILLING_LEDGER_IMPL=postgres
BILLING_INTERNAL_TOKEN=opendesk-dev-billing-internal-token-change-in-prod
# SPEC-W45 K contract note: identity best-effort plan push target
# (PUT {BILLING_URL}/v1/tenants/{uuid}/plan). Compose default below.
#BILLING_URL=http://billing-engine:7012

# ---------------------------------------------------------------------------
# SPEC-W44 K2 internal-token contract (boot-blocking / gate-on vars).
# Every /internal/*, /activities/* and dev/* surface requires an
# X-Internal-Token header matching the service's *_INTERNAL_TOKEN env
# (constant-time compare; 503 fail-closed when unset, 401 on mismatch).
# Values below are DEV ONLY (*-dev-token-change-in-prod) and match the
# docker-compose.yml ${VAR:-default} fallbacks; production MUST set them via
# the secrets store (docs/runbooks/secrets.md). In-cluster callers
# (notification-worker activities, service-to-service calls, k3s deployments)
# must use the SAME value as the target service. W44 F1: APISIX does NOT
# inject internal tokens on any route — human calls use K1 binding + roles.
# ---------------------------------------------------------------------------
PAYMENTS_INTERNAL_TOKEN=opendesk-dev-payments-internal-token-change-in-prod
IDENTITY_INTERNAL_TOKEN=opendesk-dev-identity-internal-token-change-in-prod
NOTIFICATION_INTERNAL_TOKEN=opendesk-dev-notification-internal-token-change-in-prod
BOOKING_INTERNAL_TOKEN=opendesk-dev-booking-internal-token-change-in-prod
# conversation-service /internal/* server gate (GDPR export/delete routes;
# fail-closed when unset). Caller: notification-worker GDPR activities
# (SPEC-W45 K19) — SAME shared var wires both sides.
CONVERSATION_INTERNAL_TOKEN=opendesk-dev-conversation-internal-token-change-in-prod

# ---------------------------------------------------------------------------
# SPEC-W45 internal-token + shared-secret additions (same K2 contract as the
# block above: X-Internal-Token, constant-time compare, fail-closed unset).
# Callers carry the SAME value as the target service — compose wires both
# sides from these single vars:
#   KYC_INTERNAL_TOKEN            kyc-service /v1/kyc/resolve; caller: booking lending
#   MODEL_REGISTRY_INTERNAL_TOKEN model-registry register/promote/rollback/experiments;
#                                 callers: booking campaignstudio, graph-ml, fraud-engine
#   FRAUD_INTERNAL_TOKEN          fraud-engine /v1/detect/*
#   CRM_SYNC_INTERNAL_TOKEN       crm-sync /v1/tasks + /v1/people/lookup
#   VOICE_ADMIN_INTERNAL_TOKEN    voice /voice-admin/* server-side guard (K15d)
# ---------------------------------------------------------------------------
KYC_INTERNAL_TOKEN=opendesk-dev-kyc-internal-token-change-in-prod
MODEL_REGISTRY_INTERNAL_TOKEN=opendesk-dev-model-registry-internal-token-change-in-prod
FRAUD_INTERNAL_TOKEN=opendesk-dev-fraud-internal-token-change-in-prod
CRM_SYNC_INTERNAL_TOKEN=opendesk-dev-crm-sync-internal-token-change-in-prod
VOICE_ADMIN_INTERNAL_TOKEN=opendesk-dev-voice-admin-internal-token-change-in-prod

# ---------------------------------------------------------------------------
# SPEC-W45 secrets (DEV ONLY defaults; prod via the secrets store,
# docs/runbooks/secrets.md):
#   KYC_HASH_SECRET    HMAC-SHA256 key for BVN/NIN id_value_hash (K22;
#                      fail-closed unset in the prod profile).
#   PHONE_HASH_SALT    shared SHA-256 salt for phone hashing (graph-sync,
#                      graph-service, voice ToolInvoked/capture events).
#   FALKORDB_PASSWORD  graph-db requirepass (OOS-14; graph-service / graph-ml /
#                      fraud-engine authenticate with it).
#   AT_CALLBACK_SECRET Africa's Talking USSD callback path secret (K14) —
#                      register https://<host>/ussd/callback/<this-value> in
#                      the AT dashboard.
# ---------------------------------------------------------------------------
KYC_HASH_SECRET=opendesk-dev-kyc-hash-secret-change-in-prod
PHONE_HASH_SALT=opendesk-dev-phone-salt
FALKORDB_PASSWORD=dev-only
AT_CALLBACK_SECRET=opendesk-dev-at-callback-secret-change-in-prod

# ---------------------------------------------------------------------------
# SPEC-W45 transactional email (K8 invites/welcome + K10 Keycloak realm
# bootstrap). Dev default is the bundled mailpit catcher (UI:
# http://localhost:8025); prod points both families at the real relay.
#   SMTP_*            dapr bindings-smtp placeholders (notification-worker)
#   KC_REALM_SMTP_*   identity-service PATCHes the Keycloak realm smtpServer
#                     at bootstrap (fail-soft when unreachable)
# ---------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_FROM=OpenDesk <no-reply@opendesk.local>
KC_REALM_SMTP_HOST=mailpit
KC_REALM_SMTP_PORT=1025
KC_REALM_SMTP_FROM=no-reply@opendesk.local
KC_REALM_SMTP_USER=
KC_REALM_SMTP_PASSWORD=

# Public app origin embedded in invite/welcome emails (K8) and other
# customer-facing links. Dev default is the gateway origin.
APP_BASE_URL=http://localhost:9080

# SPEC-W45 service wiring (compose already carries these fallbacks; set here
# only for bare/e2e runs outside the dev compose):
#PAYMENTS_URL=http://localhost:7004          # booking -> payments capture/refund (K11/K12)
#BOOKING_URL=http://localhost:7002           # voice/voice-worker OTP gate (K15c — FAIL-CLOSED unset: portal request/verify-code) + messaging-gateway incident bridge (empty = Dapr invoke)
#LENDING_KYC_URL=http://localhost:7013       # booking lending -> kyc resolve (K22)
#BOOKING_KYC_SERVICE_URL=http://localhost:7013  # booking -> kyc documents + review (SPEC-W58; owner/admin routes)
#MODEL_REGISTRY_URL=http://localhost:7019    # booking campaignstudio A/B (U6)
#FLUVIO_ENDPOINT=localhost:9003              # gateway-edge (ORPH O13 rename)
#PIPER_HTTP_URL=http://localhost:5500        # voice-worker TTS (ORPH O14 rename)
#KYC_EVENTS_TOPIC=opendesk.kyc.resolved.v1   # kyc-service (ORPH O12 rename)

# ---------------------------------------------------------------------------
# SPEC-W44 F16-7 (partial): boot-blocking vars for running services OUTSIDE
# the dev compose (compose itself carries ${VAR:-default} fallbacks for all
# of these — cp .env.example .env is only needed for bare/e2e runs).
# ---------------------------------------------------------------------------
# payments-service: REFUSES to boot without an explicit ledger selection
# (src/config.rs). sim = in-memory dev ledger (moves no real money);
# tigerbeetle = live ledger (needs TB_ADDRESSES).
LEDGER_IMPL=sim
# payments-service: Mojaloop FSPIOP endpoint. Compose points at the bundled
# simulator (http://mojaloop:8444); a bare run needs a reachable endpoint AND
# MOJALOOP_ALLOW_SIM=1, or boot aborts (fail-closed).
#MOJALOOP_ENDPOINT=http://localhost:8444
#MOJALOOP_ALLOW_SIM=1
# ---------------------------------------------------------------------------
# Payments: Flutterwave rail (SPEC-W12 §6/§8; read by payments-service
# src/flutterwave.rs via std::env::var — W48-D recon F7 found all four
# missing from this file). Fail-closed while unset: the initialize route
# answers 503 "FLUTTERWAVE_SECRET_KEY is not configured" and the webhook
# 503s until FLUTTERWAVE_SECRET_HASH is set (webhook auth: verif-hash
# header == FLUTTERWAVE_SECRET_HASH). Compose already passes
# FLUTTERWAVE_SECRET_KEY/SECRET_HASH through for the payments container;
# the placeholders below are for bare/e2e runs and documentation. Prod
# values come from the secrets store (docs/runbooks/secrets.md) — never
# commit real keys.
# ---------------------------------------------------------------------------
# Flutterwave v3 API base. Code default when unset:
# https://api.flutterwave.com/v3 — override only for a stub/mock server.
#FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
#FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Webhook verif-hash shared secret (Flutterwave dashboard -> Settings ->
# Webhooks -> secret hash).
#FLUTTERWAVE_SECRET_HASH=opendesk-dev-flutterwave-secret-hash-change-in-prod
# Optional standard-checkout redirect target after payment (code default:
# none — Flutterwave's default redirect behavior applies).
#FLUTTERWAVE_REDIRECT_URL=http://localhost:9080/
# booking-service: HMAC secret for 15-min customer-portal JWTs. W44 B-side:
# boot fails when this still equals the dev default unless
# OPENDESK_DEV_INSECURE=1 — set a real value for any non-local deployment.
# SHARED (SPEC-W45 STK O13): booking-service SIGNS portal JWTs with this
# and identity-service VERIFIES them on the consent portal path
# (internal/consent/portal.go) — booking + identity MUST carry the same
# value. (notification-worker does NOT read it; claim links use random
# tokens.)
PORTAL_SECRET=opendesk-dev-portal-secret-change-in-prod
# DEV ONLY: required for local boot while PORTAL_SECRET above is the dev
# default. Delete this line for any non-local deployment.
OPENDESK_DEV_INSECURE=1
# gateway-edge: opt-in Fluvio stub consumer when running without a Fluvio
# broker. The default compose build now compiles the fluvio-live feature
# (CARGO_FEATURES=fluvio-live build arg, W44 F15-01), so this stays 0/unset.
#GATEWAY_EDGE_ALLOW_SIM=0
# graph-service (infra/docker-compose.graph.yml): REQUIRED since W44
# S1-F6-01 — no compose default anymore (${INTERNAL_TOKEN:?...}). Guards the
# /v1/graph/internal/* write-back routes; graph-ml/graph-ml-gpu read the
# same variable. The graph overlay also sets REQUIRE_JWT=1 (startup raises
# when JWT_PUBLIC_KEY is empty); set JWT_PUBLIC_KEY or REQUIRE_JWT=0
# explicitly for header-seam e2e.
INTERNAL_TOKEN=opendesk-dev-internal-token
#JWT_PUBLIC_KEY=
#REQUIRE_JWT=1
# voice-worker: /metrics (prometheus_client) port, scraped by the Prometheus
# voice-worker job (infra/observability/prometheus/prometheus.yml).
VOICE_WORKER_METRICS_PORT=9464

# ---------------------------------------------------------------------------
# W39 graph dev/e2e seams (infra/docker-compose.graph.yml) — SAFE DEFAULTS
# OFF since W39 SIM-028. e2e suites that rely on header-based tenant auth or
# the fixture seeder must opt in EXPLICITLY in the e2e runner environment:
#AUTHZ_DISABLED=true       # graph-service: X-Tenant-Slug header auth seam
#E2E_FIXTURES=1            # graph-service: POST /v1/graph/internal/fixtures/seed
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# SPEC-W45 FX3 documentation block (all COMMENTED — compose carries working
# ${VAR:-default} fallbacks for every entry; set here only to override or
# for bare/e2e runs outside the dev compose):
# ---------------------------------------------------------------------------
# Voice verified-session OTP (SPEC-W45 K15c) — voice + voice-worker call the
# booking portal request-code/verify-code endpoints; fail-closed when the
# URL or token is unset. Compose wires VOICE_BOOKING_INTERNAL_TOKEN from the
# shared BOOKING_INTERNAL_TOKEN var (must equal the booking block's value):
#BOOKING_URL=http://booking:7002
#VOICE_BOOKING_INTERNAL_TOKEN=<same value as BOOKING_INTERNAL_TOKEN>
# messaging-gateway (SPEC-W45 K14): per-phone rate limit on the Africa's
# Talking USSD callback (POST /ussd/callback/{secret}); code default 30/min:
#USSD_RATE_LIMIT_PER_MINUTE=30
# payments-service (SPEC-W45 K20): payouts at/above this amount (kobo)
# require an approval step. DEFAULT 0 = DISABLED (every payout auto-approves):
#PAYOUT_APPROVAL_THRESHOLD_KOBO=0
# Graph plane (infra/docker-compose.graph.yml): the tenant graph name
# graph-sync writes and graph-service/graph-ml/fraud-engine query (MUST be
# agora_tenants — the old code default `opendesk` was a split-brain), and
# the graph-sync embed client base (OpenAI-compatible; MUST carry /v1;
# ollama-graph hosts the bootstrapped nomic-embed-text):
#FALKORDB_GRAPH=agora_tenants
#OLLAMA_BASE_URL=http://ollama-graph:11434/v1
# Identity event consumption: notification-worker consumes identity lifecycle
# events (topic/group below); booking-service also reads IDENTITY_EVENTS_GROUP:
#IDENTITY_EVENTS_TOPIC=opendesk.identity.events
#IDENTITY_EVENTS_GROUP=notification-identity-events
# Billing event consumption (notification-worker -> customer receipts):
#BILLING_EVENTS_TOPIC=opendesk.billing.events
#BILLING_EVENTS_GROUP=notification-billing-events
# Shared dead-letter topic for poison Kafka messages (notification-worker,
# booking-service, crm-sync; graph-sync uses GRAPH_SYNC_DLQ_TOPIC):
#DLQ_TOPIC=opendesk.dlq
# conversation-service helpdesk automation (SPEC-W45 UC-helpdesk): channel→
# ticket escalation calls booking /v1/helpdesk/tickets via Dapr app-id
# BOOKING_APP_ID, carrying X-Internal-Token ==
# CONVERSATION_BOOKING_INTERNAL_TOKEN (compose wires it from the shared
# BOOKING_INTERNAL_TOKEN var; must equal the booking block's value):
#HELPDESK_AUTOMATION_ENABLED=true
#BOOKING_APP_ID=booking
#CONVERSATION_BOOKING_INTERNAL_TOKEN=<same value as BOOKING_INTERNAL_TOKEN>
# conversation-service tenant-lifecycle consumer group (identity events ->
# tenant cache invalidation):
#TENANT_EVENTS_GROUP=conversation-tenant-lifecycle
# Seed prod guard (SPEC-W45 OOS-23, scripts/seeds/_lib.py): seeding a DSN
# that looks non-local fails closed unless this explicit escape is set.
# NEVER set in a real environment:
#SEED_ALLOW_PROD=0

# ---------------------------------------------------------------------------
# SPEC-W52: geo-service (Rust/terrio) — boundary ingest, point-in-polygon
# enrichment, self-hosted PMTiles tiles/style (Scope A); booking-service
# enrichment client + coverage-zone enforcement (Scope B); admin-web map
# style (Scope C). Compose carries ${VAR:-default} fallbacks; set here only
# to override.
# ---------------------------------------------------------------------------
# geo-service runtime DSN into the BOOKING PostGIS database, least-privilege
# app_geo_login role (05-app-roles.sql / migrations/0001_geo.sql). REQUIRED —
# geo-service refuses to boot without it:
GEO_DATABASE_URL=postgres://app_geo_login:app_geo_dev_password@localhost:5432/booking
# PMTiles archive for GET /v1/geo/tiles/{z}/{x}/{y}.mvt + /v1/geo/style.json.
# EMPTY = tiles disabled: both endpoints fail closed with 503 + plain error
# (real disabled-config semantics, NOT a mock). Provision offline with:
#   terrio convert boundaries.gpkg /data/geo/boundaries.pmtiles --maxzoom 10
#GEO_TILES_PATH=/data/geo/boundaries.pmtiles
GEO_TILES_PATH=
# geo-service listen address (compose default 0.0.0.0:7015):
GEO_BIND=0.0.0.0:7015
# booking-service -> geo-service enrichment client (Scope B). EMPTY =
# enrichment disabled (fail-open, business writes never block):
GEO_SERVICE_URL=http://geo:7015
# booking-service coverage-zone enforcement at public booking create
# (Scope B). DEFAULT FALSE = inert: bookings pass regardless of geography.
# When true AND the site has >=1 active service_areas row AND the booking
# contact has a location point, an uncovered point is rejected 422
# GEO_OUTSIDE_COVERAGE. Sites without areas always pass (documented
# semantics, not a stub):
BOOKING_GEO_ENFORCE=false
# admin-web (Scope C): MapLibre style URL replacing the hot-linked OSM
# raster style. Default is served by geo-service through APISIX:
NEXT_PUBLIC_GEO_STYLE_URL=/api/geo/style.json

# ---------------------------------------------------------------------------
# SPEC-W53 Scope A: ocr-service (:7020) — MiniCPM-OCR document intelligence.
# The MiniCPM-OCR GGUFs are provisioned ONCE into the ocr-models volume
# (runbook + LICENSE warning in services/ocr-service/README.md); the
# llama-ocr sidecar starts via `-f infra/compose/ocr.compose.yml`.
#   OCR_DATABASE_URL   full DSN override; unset -> compose builds
#                      postgres://$OCR_PG_USER:$OCR_PG_PASS@postgres:5432/ocr
#                      (least-privilege app_ocr_login, 05-app-roles.sql)
#   OCR_LLM_BASE_URL   OpenAI-compatible llama-server sidecar base URL
#   OCR_MODEL          model name sent on /v1/chat/completions
#   OCR_MAX_BYTES      upload hard cap (25 MiB = 26214400)
#   OCR_TIMEOUT_S      sidecar call budget — CPU OCR is slow; NO retries
#   OCR_MINIO_BUCKET   MinIO bucket for uploaded document bytes (PII,
#                      tenant-prefixed keys; created by the lakehouse
#                      createbucket job; credentials reuse MINIO_ROOT_*)
#   OCR_USAGE_TOPIC / OCR_EVENTS_TOPIC — metering + domain event topics
# ---------------------------------------------------------------------------
OCR_PG_USER=app_ocr_login
OCR_PG_PASS=app_ocr_dev_password
#OCR_DATABASE_URL=postgres://app_ocr_login:app_ocr_dev_password@postgres:5432/ocr
OCR_LLM_BASE_URL=http://llama-ocr:8080/v1
OCR_MODEL=minicpm-ocr
OCR_MOCK=false
OCR_MAX_BYTES=26214400
OCR_TIMEOUT_S=120
OCR_MINIO_BUCKET=documents
#OCR_USAGE_TOPIC=opendesk.usage.events
#OCR_EVENTS_TOPIC=opendesk.ocr.events
# SPEC-W58 GATE R3 (KYC retention TTL): kyc_* documents are inserted with
# expires_at = now() + OCR_KYC_TTL_HOURS; the periodic sweeper deletes
# expired rows + MinIO objects every OCR_KYC_SWEEP_MINUTES. ENV PARITY:
# defaults MUST equal the code reads in services/ocr-service/app/config.py.
OCR_KYC_TTL_HOURS=72
OCR_KYC_SWEEP_MINUTES=15
# Service-to-service auth (SPEC-W44 K2 contract — X-Internal-Token,
# constant-time compare, fail-closed when unset). Callers (booking-service
# fieldcapture receipt OCR) carry the SAME value; APISIX strips
# client-supplied x-internal-token so gateway calls can never forge it.
OCR_INTERNAL_TOKEN=opendesk-dev-ocr-internal-token-change-in-prod
# Caller side (booking-service fieldcapture receipt OCR, SPEC-W53 Scope B):
# base URL of the ocr-service on the opendesk docker network. Empty disables
# the receipt endpoint (fail-closed 503).
OCR_SERVICE_URL=http://ocr:7020
# Caller side (kyc-service KYC document pipeline, SPEC-W58): kyc forwards
# document bytes to ocr-service /v1/ocr/extract with X-Internal-Token
# matching OCR_INTERNAL_TOKEN above (SAME shared var). Empty disables the
# kyc document endpoint (fail-closed).
KYC_OCR_BASE_URL=http://ocr:7020

# ---------------------------------------------------------------------------
# SPEC-W55: fraud D9 document_abuse — same-tenant duplicate / near-duplicate
# / tamper-suspect detection over hash-only (:Document) stubs that graph-sync
# projects from com.opendesk.ocr.DocumentExtracted on opendesk.ocr.events
# (compose carries working ${VAR:-default} fallbacks for every entry — set
# here only to override; defaults MUST match the code defaults):
#   GRAPH_SYNC_OCR_TOPIC     graph-sync OCR consumer topic (empty = consumer
#                            skipped, civic/CAC pattern); infra/kafka/
#                            create-topics.sh already registers the topic
#GRAPH_SYNC_OCR_TOPIC=opendesk.ocr.events
# fraud-engine D9 thresholds (fraud_engine/config.py; D9 NEVER
# auto-quarantines — operator triage only). S1 exact sha256 dup: >= min =>
# medium, >= high => high; S2 near-dup: phash hamming at/below max => medium:
#D9_LOOKBACK_DAYS=30
#D9_DUP_MIN_COUNT=2
#D9_DUP_HIGH_COUNT=3
#D9_PHASH_HAMMING_MAX=6

# ---------------------------------------------------------------------------
# SPEC-W54 Scope A: rdf-export (:7021) — Rust/oxirs batch linked-data export.
# Consumes graph-service's internal NDJSON export and lands Turtle + JSON-LD
# at s3://$RDF_MINIO_BUCKET/extracts/graph_rdf/{tenant_id}/{snapshot_date}/.
# MESH-INTERNAL ONLY: no APISIX route, no published host port.
#   RDF_EXPORT_BIND            listen address (compose default 0.0.0.0:7021)
#   GRAPH_SERVICE_URL          upstream NDJSON producer (graph overlay)
#   GRAPH_INTERNAL_TOKEN       outbound X-Internal-Token; MUST equal
#                              graph-service's INTERNAL_TOKEN (same dev value
#                              as the INTERNAL_TOKEN entry above; prod via the
#                              secrets store — -change-in-prod posture)
#   RDF_EXPORT_INTERNAL_TOKEN  inbound X-Internal-Token guard for
#                              /v1/rdf-export/* (constant-time, fail-closed:
#                              unset in the service env = 503 posture)
#   RDF_MINIO_BUCKET           MinIO extract bucket (created by the lakehouse
#                              createbucket job; credentials reuse MINIO_ROOT_*)
#   RDF_EXPORT_TIMEOUT_S       synchronous batch run budget (504 on expiry)
# ---------------------------------------------------------------------------
RDF_EXPORT_BIND=0.0.0.0:7021
GRAPH_SERVICE_URL=http://graph-service:7014
GRAPH_INTERNAL_TOKEN=opendesk-dev-internal-token
RDF_EXPORT_INTERNAL_TOKEN=opendesk-dev-rdf-export-internal-token-change-in-prod
RDF_MINIO_BUCKET=lake
RDF_EXPORT_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# SPEC-W56: receipt ↔ payment reconciliation (booking-service internal/recon).
# Matches field-captured receipts (W53 receipt_fields) against payment state
# on a ticker sweep (+ POST /v1/internal/recon/receipts manual trigger),
# persists confidence-tagged findings, emits ops alerts via the existing
# outbox → notification-worker → opendesk.ops.alerts pipeline, and serves
# read-back at GET /api/bookings/v1/recon/receipts (admin page
# /app/[orgSlug]/bookings/reconciliation; runbook:
# docs/runbooks/operations.md §9). ENV PARITY: names + defaults below MUST
# equal booking-service internal/config/config.go reads.
#   RECON_SWEEP_MINUTES       sweep ticker interval in minutes (0 = disabled)
#   RECON_LOOKBACK_DAYS       trailing days swept per run
#   RECON_MATCH_WINDOW_DAYS   exact rung: paid booking within ±N days of capture
#   RECON_AMOUNT_WINDOW_DAYS  heuristic rung: |receipt date − paid_at| ≤ N days
# ---------------------------------------------------------------------------
RECON_SWEEP_MINUTES=60
RECON_LOOKBACK_DAYS=30
RECON_MATCH_WINDOW_DAYS=7
RECON_AMOUNT_WINDOW_DAYS=3
