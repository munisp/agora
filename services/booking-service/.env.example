# booking-service configuration (copy to .env for local dev)
# Defaults shown match internal/config/config.go; unset vars fall back to them.

# HTTP
PORT=7002
SHUTDOWN_TIMEOUT_SECONDS=10

# Postgres (DATABASE_URL wins; PG_* parts override it when set)
DATABASE_URL=postgres://opendesk:opendesk@localhost:5432/bookings?sslmode=disable
PG_USER=
PG_PASS=
PG_DATABASE=
PG_DSN=
PG_MAX_CONNS=20

# Redis
REDIS_ADDR=localhost:6379

# Dapr
DAPR_HOST=daprd-booking
DAPR_HTTP_PORT=3500
DAPR_PUBSUB_NAME=opendesk-pubsub

# Temporal
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=booking-tasks

# Kafka topics / consumer groups
KAFKA_BROKERS=localhost:9092
CONSUMER_ENABLED=true
BOOKING_COMMANDS_TOPIC=opendesk.booking.commands.v1
BOOKING_COMMANDS_GROUP=booking-service
BOOKING_EVENTS_TOPIC=opendesk.booking.events.v1
NOTIFICATIONS_TOPIC=opendesk.notifications.v1
INCIDENTS_TOPIC=opendesk.incidents.v1
INCIDENTS_GROUP=booking-incidents
CAC_EVENTS_TOPIC=cac.events
PRIVACY_EVENTS_TOPIC=opendesk.privacy.events.v1
PRIVACY_EVENTS_GROUP=booking-privacy
USAGE_EVENTS_TOPIC=opendesk.usage.metering.v1
DLQ_TOPIC=opendesk.booking.commands.dlq
OUTBOX_POLL_INTERVAL_SECONDS=5

# AuthN/AuthZ
IDENTITY_APP_ID=identity-service
PERMIFY_URL=localhost:3476
AUTHZ_DISABLED=false
AUTHZ_OUTAGE_POLICY=fail_closed   # fail_closed (default) | fail_open
PORTAL_SECRET=change-me           # HMAC secret for contact-portal magic codes

# Caches
CACHE_TTL_SECONDS=120
CACHE_STALE_TTL_SECONDS=900
TENANT_CACHE_TTL_SECONDS=300

# Geo (W8/W12)
GEOCODE_ENABLED=false
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
GEO_CAMPAIGN_BATCH=50

# Incidents (W11)
INCIDENT_AUTO_DISPATCH=true

# Growth / CAC (W13)
LEAD_ATTRIBUTION_FIRST_TOUCH_ONLY=true

# Referrals / commissions (W14)
COMMISSIONS_ENABLED=true            # false -> referral/commission endpoints 503
PAYOUT_PROVIDER=paystack
PAYOUT_MIN_NGN=100                  # minimum payout, whole naira
RECON_CRON=30 2 * * *               # commission-recon-nightly, Africa/Lagos

# Field capture (W16)
FIELD_CAPTURE_BATCH_LIMIT=100       # max items per POST /v1/field/capture
