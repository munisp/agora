// schema.perm — OpenDesk ReBAC model (SPEC §8), Permify DSL v1.
// booking-service calls Permify gRPC Check before mutations with
// subject = user:{JWT sub}, resource = organization:{tenant_id}.

entity user {}

entity organization {

    relation owner  @user
    relation admin  @user
    relation member @user
    relation viewer @user
    relation analyst @user
    relation billing @user

    // Catalog (offerings/team/availability) management.
    permission manage_catalog  = owner or admin
    // Booking mutations (book/reschedule/cancel).
    permission manage_bookings = owner or admin or member
    // Dashboard read access.
    permission view_dashboard  = owner or admin or member or viewer
    // Public booking site /p/{siteSlug} publishing.
    permission publish_site    = owner or admin
    // KPI/analytics dashboards (Wave 7): read-only, no mutations.
    // W47 UIMOB-07: member (Keycloak staff) is included so field staff can
    // READ the same-tenant growth/ops lists they write via manage_bookings
    // (mobile Leads/Growth tabs: /v1/leads, /v1/referrals, /v1/payouts —
    // booking-service gates those reads on this permission). Scope note:
    // every Permify check evaluates against organization:{tenant_id}, so
    // this is strictly tenant-local and grants NO cross-tenant analytics;
    // the admin-web analytics section (KPI cards, text-to-SQL) is
    // additionally realm-role gated (owner/admin/analyst only) and is
    // unaffected by this grant.
    permission view_analytics  = owner or admin or analyst or member
    // Invoices, rate cards, payment links (Wave 7 billing-engine; W47-D
    // wires enforcement). The billing relation is granted via identity
    // invite realm_roles (platform-admin only, STK O4) which now also
    // writes the Permify tuple (W47 role-mapping fix).
    permission view_billing    = owner or billing
    permission manage_billing  = owner or billing
}

entity offering {

    // Parent organization (tenant).
    relation org @organization

    permission edit = org.manage_catalog
    permission view = org.view_dashboard
}

entity booking {

    relation org @organization

    permission manage = org.manage_bookings
    permission view   = org.view_dashboard
}

entity site {

    relation org @organization

    permission publish = org.publish_site
    permission view    = org.view_dashboard
}
